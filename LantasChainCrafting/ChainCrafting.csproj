<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\..\SextantHorizon\SextantHorizon.projitems" Label="Shared" />
	<Import Project="BuildVariables.targets" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ChainCrafting</AssemblyName>
	  <BepInExPluginGuid>com.lanta.ChainCrafting</BepInExPluginGuid>
	  <BepInExPluginName>Chain Crafting</BepInExPluginName>
	  <Version>3.3.1</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>14</LangVersion>
    <RootNamespace>ChainCrafting</RootNamespace>
    
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
    </RestoreAdditionalProjectSources>
    
    <AssemblyTitle>ChainCrafting</AssemblyTitle>
    
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
	
  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="1.1.0" />
    <PackageReference Include="Subnautica.Nautilus" Version="1.0.0-pre.50" />
    <PackageReference Include="UnityEngine.Modules" Version="2019.4.36" IncludeAssets="compile" />
    <PackageReference Include="Unity.InputSystem" Version="1.4.1" IncludeAssets="compile" />
    <PackageReference Include="Subnautica.GameLibs" Version="82304.0.0-r.0" />
    <PackageReference Include="PolySharp" Version="1.15.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="OpenLockerAPI">
      <HintPath>..\..\..\externalDLLs\OpenLockerAPI\OpenLockerAPI.dll</HintPath>
      <Aliases>OpenLocker</Aliases>
    </Reference>
  </ItemGroup>
	
	<ItemGroup>
		<Localizations Include="$(ProjectDir)Localization\*.*" />
	</ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
	  <MakeDir Directories="$(GameDir)\BepInEx\plugins\$(TargetName)\Localization" />
	  <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\$(TargetName)" />
	  <Copy SourceFiles="@(Localizations)" DestinationFolder="$(GameDir)\BepInEx\plugins\$(TargetName)\Localization" />
	  <MakeDir Directories="$(TargetDir)_tempZip\plugins\$(TargetName)\Localization" />
	  <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(TargetDir)_tempZip\plugins\$(TargetName)" />
	  <Copy SourceFiles="@(Localizations)" DestinationFolder="$(TargetDir)_tempZip\plugins\$(TargetName)\Localization" />
	  <ZipDirectory SourceDirectory="$(TargetDir)_tempZip\" DestinationFile="$(ReleasePath)\$(TargetName).zip" Overwrite="true" />
  </Target>
</Project>
